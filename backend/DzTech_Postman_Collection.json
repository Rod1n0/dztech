{
  "info": {
    "name": "DzTech E-Commerce API (TD-TP 3)",
    "_postman_id": "dztech-ensta-wamd-tp3-collection",
    "description": "Complete Postman Collection for ENSTA WAMD TD-TP 3: Authentication (Register, Login, JWT, OAuth 2.0 + PKCE), Product CRUD, Security & Error Handling, and Rate Limiting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "sample_product_id",
      "value": "65f000000000000000000001",
      "type": "string"
    },
    {
      "key": "created_product_id",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "grant_type",
        "value": "authorization_code_with_pkce",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "{{base_url}}/api/oauth/authorize",
        "type": "string"
      },
      {
        "key": "accessTokenUrl",
        "value": "{{base_url}}/api/oauth/token",
        "type": "string"
      },
      {
        "key": "clientId",
        "value": "dztech-postman-client",
        "type": "string"
      },
      {
        "key": "challengeAlgorithm",
        "value": "S256",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "openid profile email products:write",
        "type": "string"
      },
      {
        "key": "addTokenTo",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Register New User (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"BOUDISSA Farouk Radouane\",\n  \"email\": \"farouk.boudissa@ensta.edu.dz\",\n  \"password\": \"SecurePass2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Register Duplicate Email (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"BOUDISSA Farouk Radouane\",\n  \"email\": \"farouk.boudissa@ensta.edu.dz\",\n  \"password\": \"SecurePass2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "1.3 Login with Valid Credentials (200 OK + JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "  pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farouk.boudissa@ensta.edu.dz\",\n  \"password\": \"SecurePass2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "1.4 Login with Invalid Credentials (401 Unauthorized)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farouk.boudissa@ensta.edu.dz\",\n  \"password\": \"WrongPassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Product Management",
      "item": [
        {
          "name": "2.1 Retrieve All Products (200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "2.2 Retrieve Single Product by ID (200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/{{sample_product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "{{sample_product_id}}"]
            }
          }
        },
        {
          "name": "2.3 Create Product with Valid JWT (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData._id || jsonData.id) {",
                  "  pm.collectionVariables.set('created_product_id', jsonData._id || jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apple MacBook Pro 14 M3 Pro\",\n  \"description\": \"14-inch Liquid Retina XDR laptop with Apple M3 Pro chip and 18-hour battery life.\",\n  \"price\": 385000,\n  \"category\": \"Laptops\",\n  \"specs\": \"M3 Pro · 18GB Unified · 512GB NVMe\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=800&q=80\",\n  \"stock\": 10\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "2.4 Update Product with Valid JWT (200 OK)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 369000,\n  \"stock\": 14\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/products/{{created_product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "{{created_product_id}}"]
            }
          }
        },
        {
          "name": "2.5 Delete Product with Valid JWT (200 OK)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/products/{{created_product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "{{created_product_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Security & Error Handling",
      "item": [
        {
          "name": "3.1 Protected Request Without Token (401 Unauthorized)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unauthorized Item\",\n  \"description\": \"Testing missing token\",\n  \"price\": 12000,\n  \"category\": \"Peripherals\",\n  \"imageUrl\": \"https://example.com/item.jpg\",\n  \"stock\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "3.2 Protected Request With Invalid Token (401 Unauthorized)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer invalid_or_tampered_jwt_token_12345"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invalid Token Item\",\n  \"description\": \"Testing invalid token\",\n  \"price\": 12000,\n  \"category\": \"Peripherals\",\n  \"imageUrl\": \"https://example.com/item.jpg\",\n  \"stock\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "3.3 Invalid Product ID Format (400 Bad Request)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/invalid-id-123",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "invalid-id-123"]
            }
          }
        },
        {
          "name": "3.4 Non-Existent Product ID (404 Not Found)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/65f999999999999999999999",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "65f999999999999999999999"]
            }
          }
        },
        {
          "name": "3.5 Missing or Invalid Product Information (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Incomplete Product Without Price or Category\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            }
          }
        }
      ]
    },
    {
      "name": "4. OAuth 2.0 & OpenID Connect",
      "item": [
        {
          "name": "4.1 OIDC Discovery Configuration",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/.well-known/openid-configuration",
              "host": ["{{base_url}}"],
              "path": [".well-known", "openid-configuration"]
            }
          }
        },
        {
          "name": "4.2 OAuth 2.0 UserInfo Endpoint",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/oauth/userinfo",
              "host": ["{{base_url}}"],
              "path": ["api", "oauth", "userinfo"]
            }
          }
        }
      ]
    }
  ]
}
